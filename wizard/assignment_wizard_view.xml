<odoo>

    <record id="task_assignment_wizard_form" model="ir.ui.view">
        <field name="name">task.assignment.wizard.form</field>
        <field name="model">task.assignment.wizard</field>
        <field name="arch" type="xml">
            <form string="Assign Tasks">
                <group>
                    <field name="assigned_to"/>
                </group>
                <footer>
                    <button name="action_assign_tasks"
                            type="object"
                            string="Assign"
                            class="btn-primary"/>

                    <button string="Cancel"
                            special="cancel"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="task_assignment_wizard_action" model="ir.actions.act_window">
        <field name="name">Task Assignment</field>
        <field name="res_model">task.assignment.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="task_assignment_wizard_form"/>
        <field name="target">new</field>
    </record>

</odoo>